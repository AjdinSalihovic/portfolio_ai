# --- SMTP settings for the contact form ---
# For Gmail: create an "App Password" at https://myaccount.google.com/apppasswords
# (requires 2FA enabled). Never use your real login password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Where contact messages are delivered (defaults to SMTP_USER)
CONTACT_TO=your.email@gmail.com

# Comma-separated list of allowed frontend origins, or * for any.
# If you host frontend and backend together (default), * is fine.
ALLOWED_ORIGINS=*
